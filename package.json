{
  "name": "mission-relay",
  "version": "1.2.10",
  "private": false,
  "type": "module",
  "description": "Local-first, open-source mission control for long-running AI agents",
  "license": "Apache-2.0",
  "bin": {
    "mission-relay": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc --noEmit && node scripts/check-project-state.mjs",
    "state-check": "node scripts/check-project-state.mjs",
    "privacy-check": "node scripts/check-public-boundaries.mjs",
    "build": "tsc && node scripts/write-build-provenance.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "playwriter": "0.9.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
